{
  "name": "sentryvision",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "scripts": {
    "dev": "cd frontend-next && npm run dev -- --hostname 0.0.0.0 --port 5173",
    "dev:server": "cd server && npm run dev",
    "dev:full": "npm run kill:ports && concurrently \"npm run dev:server\" \"wait-on -t 30000 http://localhost:9753 && npm run dev\"",
    "kill:ports": "lsof -ti:9753 | xargs kill -9 2>/dev/null || true && lsof -ti:5173 | xargs kill -9 2>/dev/null || true",
    "build": "cd frontend-next && npm run build",
    "build:server": "cd server && npm run build",
    "build:full": "npm run build && npm run build:server",
    "lint": "cd frontend-next && npm run lint",
    "lint:fix": "cd frontend-next && npm run lint -- --fix",
    "lint:server": "cd server && eslint src --ext .ts",
    "format": "prettier --write \"frontend-next/src/**/*.{ts,tsx,js,jsx,css}\" \"server/src/**/*.{ts,js}\" \"*.{json,md}\" \".prettierrc\" \".editorconfig\"",
    "format:check": "prettier --check \"frontend-next/src/**/*.{ts,tsx,js,jsx,css}\" \"server/src/**/*.{ts,js}\" \"*.{json,md}\"",
    "typecheck": "cd frontend-next && npm run typecheck",
    "preview": "python3 -m http.server 4173 --directory frontend-next/out",
    "health:check": "npm run build && npm run lint && npm run typecheck && echo '✅ Frontend health check passed!'",
    "test:server": "cd server && npm run test:server"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/faker": "^6.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/speakeasy": "^2.0.10",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.11",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.21",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "puppeteer": "^25.5.0"
  }
}
